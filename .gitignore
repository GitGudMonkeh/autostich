# Sim-Scratch (WIP-Messungen, nicht committen)
*.scratch.*

# Temporäre Agent-Worktrees (nicht versionieren)
.claude/worktrees/

# Python-Bytecode aus scripts/ (entsteht, sobald ein Werkzeug skill-art-build.py importiert
# statt es aufzurufen — z. B. beim Nachmessen). Gehoert nie in den Baum.
__pycache__/
*.pyc

# Bild-Originale vor `scripts/normalize-art.py --apply`. Lokale Bequemlichkeit —
# die echte Sicherung ist der Commit vor dem Bake, deshalb nicht im Repo.
src/assets/**/_raw/

# Arbeitsausgabe von scripts/bf-beitrag.mjs (Messwerte + Vorher/Nachher-Aufnahmen).
# Die Belege, die bleiben sollen, stehen als Begruendung an den Eintraegen in
# src/ui/cosmeticAssets.js — so wie bei BATTLEFIELD_VEIL.
test/evidence/
